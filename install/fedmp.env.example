# Settings for the NSX Federation pack install. Copy to ~/fedmp.env, fill in, and keep it private:
#   cp install/fedmp.env.example ~/fedmp.env && chmod 600 ~/fedmp.env
# The command blocks of docs/INSTALL.md that need these values start by loading it:
#   set -a; source ~/fedmp.env; set +a

# Build host: the address the cloud proxy uses to reach the registry
IP=10.x.x.x
# Pack version, as in pack/manifest.txt
VERSION=1.13.0

# VCF Operations (steps 6 to 10)
OPS_HOST=ops.example.com
OPS_PW='<admin password>'
# Only when this host does not trust the certificate of VCF Operations (scripts of steps 6, 9 and 10):
# OPS_CA=/path/to/ca.pem   # the CA file to check the certificate against
# OPS_INSECURE=1           # lab only: skip the certificate check of the Suite API

# vCenter that runs the cloud proxy VM (step 4, govc)
GOVC_URL=vcenter.example.com
GOVC_USERNAME='administrator@vsphere.local'
GOVC_PASSWORD='<password>'
GOVC_INSECURE=1
PROXY_VM=cloud-proxy-vm-name
PROXY_ROOT_PW='<root password of the cloud proxy>'

# NSX: the Global Managers and a read-only account (optional test of step 5, account of step 7)
GM_HOSTS=gm1.example.com,gm2.example.com
NSX_USER=audit
NSX_PASSWORD='<password>'

# Only for the Harbor variant and the mirror variant of Option A: remove the # and fill in.
# With the mirror variant, HARBOR is the address of the internal registry, Harbor or not.
# HARBOR=harbor.example.com
# HARBOR_PROJECT=nsxfederation
# HARBOR_USER='robot$nsxfederation+build'
# HARBOR_PW='<secret>'
